NODE_ENV=production
PORT=8000
APP_NAME=CoGG SOS Backend
# Must be a specific origin in production, not *
CLIENT_ORIGIN=https://your-backend-domain.com

MONGODB_URI=
MONGODB_DB_NAME=

# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CREDENTIAL_ENCRYPTION_KEY=
BCRYPT_SALT_ROUNDS=10

EMERGENCY_LINK_BASE_URL=https://your-backend-domain.com
LIVE_LOCATION_MAX_DURATION_HOURS=3
MEDIA_MAX_UPLOAD_SIZE_MB=
RATE_LIMIT_WINDOW_MINUTES=
RATE_LIMIT_MAX_REQUESTS=
SCHEDULER_POLL_INTERVAL_MS=

STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

EMAIL_PROVIDER=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
RESEND_API_KEY=
RESEND_BASE_URL=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

ADMIN_SEED_USERNAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_MOBILE=
