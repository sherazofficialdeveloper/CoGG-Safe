# =========================
# App
# =========================
NODE_ENV=development
PORT=8000
APP_NAME=CoGG SOS Backend
CLIENT_ORIGIN=http://localhost:3000

# =========================
# MongoDB
# =========================
MONGODB_URI=mongodb://localhost:27017/cogg_sos

# =========================
# JWT
# =========================
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# =========================
# Bcrypt
# =========================
BCRYPT_SALT_ROUNDS=10

# =========================
# SOS behavior
# =========================
SOS_CANCELLATION_WINDOW_SECONDS=10
LIVE_LOCATION_MAX_DURATION_HOURS=3

# =========================
# Durable scheduler (SOS activation, live-location expiry).
# See src/modules/scheduler. Jobs are persisted in MongoDB (ScheduledJob),
# so they survive a server restart; this controls how often the poller
# checks for due jobs.
# =========================
SCHEDULER_POLL_INTERVAL_MS=5000

# =========================
# Media upload
# =========================
MEDIA_MAX_UPLOAD_SIZE_MB=15

# =========================
# Rate limiting
# =========================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# =========================
# Firebase Cloud Messaging
# =========================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =========================
# SMS Provider (abstracted - example: Twilio)
# =========================
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# =========================
# Email Provider (abstracted - example: SMTP/SendGrid)
# =========================
EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@coggsos.com

# =========================
# Storage Provider (local is the only implemented provider)
# =========================
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=uploads
STORAGE_BASE_URL=http://localhost:8000/uploads

# =========================
# Emergency call provider (abstracted — Twilio Voice by default)
# =========================
CALL_PROVIDER=twilio
# Optional — defaults to the SMS_* Twilio credentials/number above if unset.
CALL_ACCOUNT_SID=
CALL_AUTH_TOKEN=
CALL_FROM_NUMBER=
# REQUIRED for real calls to work: Twilio needs a TwiML URL telling it what
# the call should say/do once answered (e.g. a TwiML Bin URL, or your own
# webhook). Without this, the call provider throws a clear configuration
# error rather than pretending a call was placed.
CALL_TWIML_URL=

# =========================
# Emergency link
# =========================
EMERGENCY_LINK_BASE_URL=http://localhost:8000/e

# =========================
# Admin seed script (npm run seed:admin) — NOT read by the running app,
# only by src/seeds/createAdmin.js. This is the sole controlled path
# for creating an admin account; there is no API for it.
# Usage: ADMIN_SEED_USERNAME=admin ADMIN_SEED_PASSWORD='strong-pwd' \
#        ADMIN_SEED_MOBILE='03001234567' npm run seed:admin
# =========================
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_MOBILE=
ADMIN_SEED_EMAIL=
