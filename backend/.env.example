# Backend configuration
NODE_ENV=development
PORT=8000
APP_NAME=CoGG SOS Backend
CLIENT_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=YOUR_MONGODB_URI

# JWT / auth
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRES_IN=7d

# Password hashing
BCRYPT_SALT_ROUNDS=10

# SOS behavior
SOS_CANCELLATION_WINDOW_SECONDS=10
LIVE_LOCATION_MAX_DURATION_HOURS=3
SCHEDULER_POLL_INTERVAL_MS=5000

# Media
MEDIA_MAX_UPLOAD_SIZE_MB=15
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
STORAGE_PROVIDER=r2
STORAGE_LOCAL_PATH=uploads
STORAGE_BASE_URL=http://localhost:8000/uploads
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME
R2_PUBLIC_BASE_URL=https://your-public-bucket.example.com

# Firebase / notifications
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY=YOUR_FIREBASE_PRIVATE_KEY

# Email
EMAIL_PROVIDER=smtp
EMAIL_HOST=YOUR_EMAIL_HOST
EMAIL_PORT=587
EMAIL_USER=YOUR_EMAIL_USER
EMAIL_PASSWORD=YOUR_EMAIL_PASSWORD
EMAIL_FROM=noreply@example.com

# Emergency links
EMERGENCY_LINK_BASE_URL=http://localhost:8000/e

# Admin seeding
ADMIN_SEED_USERNAME=YOUR_ADMIN_SEED_USERNAME
ADMIN_SEED_PASSWORD=YOUR_ADMIN_SEED_PASSWORD
ADMIN_SEED_MOBILE=YOUR_ADMIN_SEED_MOBILE
ADMIN_SEED_EMAIL=YOUR_ADMIN_SEED_EMAIL
